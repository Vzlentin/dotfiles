#!/usr/bin/env bash
# campaign — drain a campaign queue through /go, one herdr pane per unit,
# serial; stop on the first non-shipped outcome.
#
# usage: campaign <name>        # run from inside the work repo
#
# A campaign is a state directory in the vault project folder:
#
#   $OBSIDIAN_VAULT_PATH/Projects/<project>/campaigns/<name>/
#   |- queue      one unit per line (U9a / 123), hand-maintained; blank
#   |             lines and #-comments are skipped; the loop NEVER rewrites it
#   |- log.jsonl  machine-appended ledger: {ts, unit, outcome, pr, slug}
#   `- config     optional key=value lines:
#                   plan=<campaign plan path>   context line for the prompt
#                   timeout_h=<hours>           per-unit timeout (default 14)
#                   agent_cmd=<command>         interactive agent command run
#                                               in the pane (default: pi)
#
# There is no init ceremony: mkdir -p the directory and hand-write queue
# (and optionally config). <project> is the work repo's basename matched
# case-insensitively against Projects/* — the same resolution rule
# project-memory uses. OBSIDIAN_VAULT_PATH may come from the environment or
# the repo's .env; campaigns are a vault-mode feature, so no vault is a
# clear error, not a fallback.
#
# The next unit is the first queue line with no shipped ledger entry — a
# re-run after a failure naturally retries the failed unit, and queue edits
# mid-campaign are picked up (the queue is re-read each iteration). Each
# unit runs as `<agent_cmd> "/skill:go <unit> ..."` in a fresh herdr pane;
# the agent keeps its TUI open after the run (deliberately — the pane stays
# inspectable), so herdr is used for pane split/rename/run only, never for
# completion detection. Completion is detected by polling the /go run state:
# /go's terminal stage records an `outcome` key, so the loop polls
# <git-common-dir>/go-runs/<slug>.json until the outcome appears or the
# per-unit timeout expires. Retries are guarded twice: any terminal
# `outcome` left by a previous run is cleared (run_state.py unset) before
# launch, and an outcome only counts if its state JSON is newer than the
# launch marker. No fresh outcome within the timeout is recorded as
# `timeout` — the run may be hung, blocked on input, or crashed before
# recording an outcome; the pane is preserved for inspection either way.
#
# Contract with /go (SKILL.md): the plan/issue stage records `issue` and the
# terminal merge-and-persist stage records `outcome` in
# <git-common-dir>/go-runs/<slug>.json, read here via
# `run_state.py list --json`. Code units (U9a) match the slug prefix
# (u9a-...), numeric units match the `issue` field.
#
# Requires on PATH: git, jq, herdr, python3, and the configured agent
# command (default pi). The pane shell must be bash (the prompt is quoted
# with `printf %q`).
#
# Exit codes: 0 when the queue drains, 1 on the first non-shipped outcome
# or any setup failure.
set -euo pipefail
shopt -s nullglob

RUN_STATE="$HOME/.agents/skills/go/scripts/run_state.py"
POLL_INTERVAL_S=30 # seconds between run-state polls

die() { echo "campaign: $*" >&2; exit 1; }

[ $# -eq 1 ] || die "usage: campaign <name>"
NAME=$1

for tool in git jq herdr python3; do
  command -v "$tool" >/dev/null || die "required tool not on PATH: $tool"
done
[ -f "$RUN_STATE" ] || die "run_state.py not found at $RUN_STATE"

REPO=$(git rev-parse --show-toplevel) || die "not inside a git repository"
RUNS_DIR="$(git rev-parse --path-format=absolute --git-common-dir)/go-runs"

VAULT=${OBSIDIAN_VAULT_PATH:-}
if [ -z "$VAULT" ] && [ -f "$REPO/.env" ]; then
  VAULT=$(sed -n 's/^OBSIDIAN_VAULT_PATH=//p' "$REPO/.env" | tail -n1 | tr -d '"')
fi
[ -n "$VAULT" ] || die "OBSIDIAN_VAULT_PATH not set (shell or $REPO/.env) — campaigns are a vault-mode feature"

# <project>: repo basename, matched case-insensitively against Projects/*.
BASE=$(basename "$REPO")
PROJECT_DIR="$VAULT/Projects/$BASE"
for d in "$VAULT/Projects"/*/; do
  entry=$(basename "$d")
  if [ "${entry,,}" = "${BASE,,}" ]; then PROJECT_DIR="$VAULT/Projects/$entry"; break; fi
done

DIR="$PROJECT_DIR/campaigns/$NAME"
QUEUE="$DIR/queue"
LEDGER="$DIR/log.jsonl"
[ -f "$QUEUE" ] || die "no queue at $QUEUE — create the campaign dir by hand (see the header of this script)"

cfg() { # key -> last value for key=... in the config file, if any
  [ -f "$DIR/config" ] || return 0
  sed -n "s/^$1=//p" "$DIR/config" | tail -n1
}

PLAN=$(cfg plan)
TIMEOUT_H=$(cfg timeout_h)
TIMEOUT_H=${TIMEOUT_H:-14}
AGENT_CMD=$(cfg agent_cmd)
AGENT_CMD=${AGENT_CMD:-pi}
TIMEOUT_S=$((TIMEOUT_H * 3600))

command -v "${AGENT_CMD%% *}" >/dev/null || die "agent command not on PATH: ${AGENT_CMD%% *}"

shipped() { # unit -> exit 0 when the ledger has a shipped entry for it
  [ -f "$LEDGER" ] || return 1
  jq -es --arg u "$1" 'any(.[]; .unit == $u and .outcome == "shipped")' "$LEDGER" >/dev/null
}

next_unit() { # print the first queue unit with no shipped ledger entry
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    line=${line%%#*}
    line=$(printf '%s' "$line" | tr -d '[:space:]')
    [ -n "$line" ] || continue
    shipped "$line" && continue
    printf '%s' "$line"
    return 0
  done <"$QUEUE"
  return 1
}

state_for() { # unit -> print the matching /go run-state JSON object, if any
  local unit=$1
  [ -d "$RUNS_DIR" ] || return 0
  if [[ $unit =~ ^[0-9]+$ ]]; then
    python3 "$RUN_STATE" list --json \
      | jq -c --arg u "$unit" 'first(.[] | select(.issue == $u)) // empty'
  else
    python3 "$RUN_STATE" list --json \
      | jq -c --arg p "${unit,,}-" 'first(.[] | select(.slug | startswith($p))) // empty'
  fi
}

prompt_for() { # unit -> the agent prompt: /skill:go line + optional plan context
  printf '/skill:go %s' "$1"
  if [ -n "$PLAN" ]; then
    printf "\nCAMPAIGN CONTEXT — not the unit spec: the campaign plan is %s. Use this unit's section as planning input only; the planning stage still makes a unit plan." "$PLAN"
  fi
}

append_ledger() { # unit outcome pr slug
  jq -cn --arg ts "$(date -Iseconds)" --arg unit "$1" --arg outcome "$2" \
    --arg pr "$3" --arg slug "$4" \
    '{ts: $ts, unit: $unit, outcome: $outcome, pr: $pr, slug: $slug}' >>"$LEDGER"
}

while UNIT=$(next_unit); do
  echo "=== $UNIT: launching /go ($(date -Iseconds)) ==="
  PROMPT=$(prompt_for "$UNIT")

  PANE=$(herdr pane split --current --direction right --cwd "$REPO" \
    | jq -r '.result.pane.pane_id // empty')
  [ -n "$PANE" ] || die "herdr pane split failed"
  herdr pane rename "$PANE" "go-$UNIT" >/dev/null

  # Retry guard, part 1: a retried unit resumes its old state file, which
  # still carries the previous run's terminal `outcome`. Clear it before
  # launch — otherwise the new run's first mid-run `set` would refresh the
  # file's mtime and launder the stale outcome past the marker check below.
  PRIOR=$(state_for "$UNIT")
  if [ -n "$PRIOR" ] && [ -n "$(jq -r '.outcome // empty' <<<"$PRIOR")" ]; then
    python3 "$RUN_STATE" unset "$(jq -r .slug <<<"$PRIOR")" outcome
  fi

  MARKER=$(mktemp) # retry guard, part 2: outcomes older than launch don't count
  herdr pane run "$PANE" "$AGENT_CMD $(printf '%q' "$PROMPT")" >/dev/null

  # Completion detection: poll the /go run state for a fresh terminal
  # `outcome` (/go always writes one, even on failure).
  DEADLINE=$((SECONDS + TIMEOUT_S))
  SLUG=""
  PR=""
  OUTCOME=""
  while [ "$SECONDS" -lt "$DEADLINE" ]; do
    STATE=$(state_for "$UNIT")
    if [ -n "$STATE" ]; then
      SLUG=$(jq -r '.slug // empty' <<<"$STATE")
      PR=$(jq -r '.pr // empty' <<<"$STATE")
      OUTCOME=$(jq -r '.outcome // empty' <<<"$STATE")
      if [ -n "$OUTCOME" ] && [ -n "$SLUG" ] && [ "$RUNS_DIR/$SLUG.json" -nt "$MARKER" ]; then
        break # fresh terminal outcome from this launch
      fi
      SLUG="" # stale or partial state: no field of it belongs in the ledger
      PR=""
      OUTCOME=""
    fi
    sleep "$POLL_INTERVAL_S"
  done
  rm -f "$MARKER"

  if [ -z "$OUTCOME" ]; then
    OUTCOME=timeout
    echo "$UNIT: no outcome recorded after ${TIMEOUT_H}h — the run may be hung, blocked on input, or crashed before recording an outcome."
  fi

  append_ledger "$UNIT" "$OUTCOME" "$PR" "$SLUG"
  if [ "$OUTCOME" = shipped ]; then
    echo "=== $UNIT: shipped ($(date -Iseconds)) ==="
    # The outcome is written before the agent's final report renders; give
    # the turn a moment to finish before tearing the pane down.
    sleep 60
    herdr pane close "$PANE" >/dev/null
  else
    echo "$UNIT: $OUTCOME — pane go-$UNIT preserved for debugging. Stopping."
    exit 1
  fi
done

echo "campaign '$NAME': queue drained."

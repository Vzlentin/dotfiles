# Send Option as Alt (ESC prefix) so the shell sees Option+Backspace as
# backward-kill-word and Option+Left/Right as word motion.
macos-option-as-alt = true

# Ghostty's default alt+arrow binds send a raw ESC b / ESC f, which Herdr drops
# under the kitty keyboard protocol. Unbound, Ghostty sends ESC[1;3D / ESC[1;3C,
# which .zshrc binds to backward-word / forward-word.
keybind = alt+arrow_left=unbind
keybind = alt+arrow_right=unbind

# Single source of truth for colors. Herdr (theme = terminal) and Neovim
# (no termguicolors) follow this palette.
theme = Desert
palette = 1=#ea6962
palette = 9=#ea6962
palette = 2=#a9b665
palette = 10=#a9b665
# Warm gray for readable comments, hidden files, and borders.
palette = 8=#a89984
cursor-color = #d4be98

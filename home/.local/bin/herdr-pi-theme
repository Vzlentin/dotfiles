#!/usr/bin/env node
// Give Herdr the colors of Pi's `system` theme for the current Ghostty theme.
//
// Pi builds its `system` theme from the terminal's colors. Herdr's `terminal` theme only uses ANSI
// color names. This script runs Pi's own generator on the colors Ghostty reports, maps Pi's tokens to
// Herdr's palette, writes them between the markers in Herdr's config.toml, and reloads Herdr.
// Run it again after you change the Ghostty theme.

import { execFileSync } from "node:child_process";
import { readFileSync, realpathSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const BEGIN = "# BEGIN herdr-pi-theme";
const END = "# END herdr-pi-theme";

// Herdr palette slot -> Pi system theme token. An empty Pi token means the terminal's own color.
const HERDR_FROM_PI = {
    accent: "accent",
    panel_bg: "toolPendingBg",
    active_row_bg: "selectedBg",
    selection_bg: "selectedBg",
    surface0: "toolPendingBg",
    surface1: "scrollbarTrack",
    surface_dim: "borderMuted",
    overlay0: "dim",
    overlay1: "muted",
    text: "text",
    subtext0: "muted",
    mauve: "accent",
    green: "success",
    yellow: "warning",
    red: "error",
    blue: "border",
    teal: "syntaxVariable",
    peach: "syntaxString",
};

const piDir = process.env.PI_INSTALL_DIR ?? join(homedir(), ".pi/agent/install");
const piVersion = readFileSync(join(piDir, "current-version"), "utf8").trim();
const systemThemePath = join(
    piDir,
    "releases",
    piVersion,
    "node_modules/@earendil-works/pi-coding-agent/dist/modes/interactive/theme/system-theme.js",
);
const { generateSystemThemeColors } = await import(systemThemePath);

const configHome = process.env.XDG_CONFIG_HOME ?? join(homedir(), ".config");
const herdrConfigPath = realpathSync(join(configHome, "herdr/config.toml"));

const ghostty = ghosttyColors();
const theme = generateSystemThemeColors(ghostty);

const lines = [
    BEGIN,
    `# Generated from Pi ${piVersion} \`system\` colors for Ghostty \`${ghostty.name}\`. Run herdr-pi-theme to update.`,
    "[theme.custom]",
    ...Object.entries(HERDR_FROM_PI).map(([slot, token]) => {
        const color = theme.colors[token];
        if (color === undefined) throw new Error(`Pi ${piVersion} has no "${token}" token`);
        return `${slot} = "${color || "reset"}"`;
    }),
    END,
];

const config = readFileSync(herdrConfigPath, "utf8");
const start = config.indexOf(BEGIN);
const end = config.indexOf(END);
if (start < 0 || end < start) {
    throw new Error(`${herdrConfigPath} needs a "${BEGIN}" ... "${END}" block after [theme]`);
}
const updated = config.slice(0, start) + lines.join("\n") + config.slice(end + END.length);
if (updated !== config) writeFileSync(herdrConfigPath, updated);

execFileSync("herdr", ["server", "reload-config"], { stdio: "inherit" });
console.log(`Herdr uses Pi ${theme.appearance} system colors for Ghostty ${ghostty.name}.`);

// `ghostty +show-config` omits values equal to Ghostty's defaults, so read those from `--default`.
function ghosttyColors() {
    const values = { ...showConfig(["--default"]), ...showConfig([]) };
    const palette = Array.from({ length: 16 }, (_, index) => rgb(values[`palette ${index}`]));
    return {
        name: values.theme || "default",
        background: rgb(values.background),
        foreground: rgb(values.foreground),
        palette,
    };
}

function showConfig(extraArgs) {
    const output = execFileSync("ghostty", ["+show-config", ...extraArgs], { encoding: "utf8" });
    const values = {};
    for (const line of output.split("\n")) {
        const match = line.match(/^([a-z-]+) = (.*)$/);
        if (!match) continue;
        const [, key, value] = match;
        const palette = key === "palette" && value.match(/^(\d+)=(#[0-9a-f]{6})$/i);
        if (palette) values[`palette ${palette[1]}`] = palette[2];
        else values[key] = value;
    }
    return values;
}

function rgb(hex) {
    if (!/^#[0-9a-f]{6}$/i.test(hex ?? "")) throw new Error(`Ghostty reported no color: ${hex}`);
    return {
        r: Number.parseInt(hex.slice(1, 3), 16),
        g: Number.parseInt(hex.slice(3, 5), 16),
        b: Number.parseInt(hex.slice(5, 7), 16),
    };
}

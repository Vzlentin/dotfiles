{
  "lastChangelogVersion": "1.3.0",
  "theme": "system",
  "externalEditor": "nvim",
  "defaultProvider": "anthropic",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:@ogulcancelik/pi-minimal-footer",
    "npm:@ogulcancelik/pi-session-recall",
    "npm:@ogulcancelik/pi-codex-compaction",
    "git:github.com/paoloanzn/pi-black",
    "https://github.com/Vzlentin/pi-ipython",
    "https://github.com/Vzlentin/pi-rlm",
    "https://github.com/Vzlentin/pi-autoresearch",
    "https://github.com/Vzlentin/pi-cursor",
    "/opt/homebrew/lib/node_modules/@vzlentin/harness/pi",
    "/opt/homebrew/lib/node_modules/@vzlentin/workflows/pi"
  ],
  "tuiMode": "fullscreen",
  "defaultTools": [
    "+codemode"
  ],
  "modelThinkingLevels": {
    "cursor/claude-opus-5-5": "medium",
    "anthropic/claude-opus-5-5": "medium",
    "radius/claude-opus-5-5": "medium",
    "cursor/claude-opus-5-5-1m": "medium"
  },
  "hideThinkingBlock": true,
  "compaction": {
    "modelOverrides": {
      "anthropic/claude-opus-5-5": {
        "reserveTokens": 64000
      }
    }
  }
}
